def CalculateMaxDrawdown(self):
            peak = self.Portfolio.TotalPortfolioValue
            max_drawdown = 0.0
            for i in range(1, len(self.Time.DateTime.date().toordinal())):
                current_value = self.Portfolio.TotalPortfolioValue
                if current_value > peak:
                    peak = current_value
                drawdown = (peak - current_value) / peak
                max_drawdown = max(max_drawdown, drawdown)
                self.daily_returns.append(self.Portfolio.TotalPortfolioValue / 100000)
            return max_drawdown

        def OnEndOfDay(self):
            self.daily_returns.append(self.Portfolio.TotalPortfolioValue / 100000)


    algorithm = Algorithm()
    algorithm.Initialize()
