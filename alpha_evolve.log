from QuantConnect.Statistics import Trade
import numpy as np
import pandas as pd

class DualEMAStrategy(QCAlgorithm):

    def Initialize(self):
        self.SetStartDate(2010, 1, 1)
        self.SetEndDate(2025, 1, 1)
        self.SetCash(100000)

        self.symbol = self.AddEquity("SPY", Resolution.Daily).Symbol

        self.fast_ema = ExponentialMovingAverage(12)
        self.slow_ema = ExponentialMovingAverage(26)
        self.RegisterIndicator(self.symbol, self.fast_ema, Resolution.Daily)
        self.RegisterIndicator(self.symbol, self.slow_ema, Resolution.Daily)

        self.entry_qty = 0.01  # 1% risk per trade
        self.stop_loss_mult = 2.0  # 2x ATR
        self.take_profit_mult = 3.0  # 3x ATR
        self.atr = self.ATR(self.symbol, 14, MovingAverageType.Simple, Resolution.Daily)

        self.long_entry = False
        self.short_entry = False
        self.in_position = False
        self.entry_price = 0.0
        self.trade_side = ""
        self.stop_loss = 0.0
        self.take_profit = 0.0
        self.previous_close = 0.0
        self.trades_list = []

        self.SetWarmUp(30)

    def OnData(self, data):
        if self.IsWarmingUp:
            return

        if not self.atr.IsReady:
            return

        price = data[self.symbol].Close

        if self.fast_ema.Current.Value > self.slow_ema.Current.Value and not self.in_position:
            self.long_entry = True
            self.short_entry = False
        elif self.fast_ema.Current.Value < self.slow_ema.Current.Value and not self.in_position:
            self.long_entry = False
            self.short_entry = True

        if self.long_entry:
            self.entry_price = price
            self.trade_side = "long"
            atr_value = self.atr.Current.Value
            self.stop_loss = self.entry_price - self.stop_loss_mult * atr_value
            self.take_profit = self.entry_price + self.take_profit_mult * atr_value

            qty = self.CalculateOrderQuantity(self.symbol, self.entry_qty)
            self.MarketOrder(self.symbol, qty)
            self.in_position = True
            self.long_entry = False
        elif self.short_entry:
            self.entry_price = price
            self.trade_side = "short"
            atr_value = self.atr.Current.Value
            self.stop_loss = self.entry_price + self.stop_loss_mult * atr_value
            self.take_profit = self.entry_price - self.take_profit_mult * atr_value
            
            qty = -self.CalculateOrderQuantity(self.symbol, self.entry_qty)
            self.MarketOrder(self.symbol, qty)
            self.in_position = True
            self.short_entry = False

        if self.in_position:
            if self.trade_side == "long":
                if price <= self.stop_loss or price >= self.take_profit:
                    self.Liquidate(self.symbol)
                    self.in_position = False
                    self.trades_list.append(price > self.stop_loss)
            elif self.trade_side == "short":
                if price >= self.stop_loss or price <= self.take_profit:
                    self.Liquidate(self.symbol)
                    self.in_position = False
                    self.trades_list.append(price < self.stop_loss)

        self.previous_close = price

    def OnEndOfAlgorithm(self):
        trades = self.TradeStatistics.Trades
        total_profit = 0.0
        for trade in trades:
            total_profit += trade.NetProfit
        
        average_profit = 0.0
        if len(trades) > 0:
            average_profit = total_profit / len(trades)

        self.cagr = self.Statistics.CompoundingAnnualReturn
        self.sharpe_ratio = self.Statistics.SharpeRatio
        self.max_drawdown = self.Statistics.Drawdown
        self.average_profit = average_profit
        self.annual_trades = self.Transactions.OrdersCount / 15


