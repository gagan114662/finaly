import QuantConnect
from QuantConnect.Algorithm import QCAlgorithm
from QuantConnect.Data.Market import TradeBar
from QuantConnect.Indicators import SimpleMovingAverage
from QuantConnect.Orders import *
import numpy as np
import pandas as pd

class MomentumBreakoutAlgorithm(QCAlgorithm):

    def Initialize(self):
        self.SetStartDate(2010, 1, 1)
        self.SetEndDate(2025, 1, 1)
        self.SetCash(100000)

        self.symbol = self.AddEquity("SPY", Resolution.Daily).Symbol
        self.sma_fast = SimpleMovingAverage(50)
        self.sma_slow = SimpleMovingAverage(200)
        self.RegisterIndicator(self.symbol, self.sma_fast, Resolution.Daily)
        self.RegisterIndicator(self.symbol, self.sma_slow, Resolution.Daily)

        self.lookback = 20
        self.high = self.MAX(self.symbol, self.lookback)
        self.low = self.MIN(self.symbol, self.lookback)

        self.entry_price = 0
        self.in_position = False
        self.trades_this_year = 0
        self.last_trade_year = -1

        self.SetWarmUp(200)

    def OnData(self, data):
        if self.IsWarmingUp:
            return

        current_year = self.Time.year
        if current_year != self.last_trade_year:
            self.trades_this_year = 0

        if not self.in_position and self.sma_fast.Current.Value > self.sma_slow.Current.Value and data[self.symbol].Close > self.high.Current.Value:
            # Enter long position
            self.SetHoldings(self.symbol, 0.1)
            self.entry_price = data[self.symbol].Close
            self.in_position = True
            self.trades_this_year += 1
            self.last_trade_year = current_year

        elif self.in_position and (data[self.symbol].Close < self.low.Current.Value or data[self.symbol].Close < self.entry_price * 0.95):
            # Exit long position
            self.Liquidate(self.symbol)
            self.in_position = False

def create_trading_strategy(input_data):

    class Algorithm(QCAlgorithm):

        def Initialize(self):
            self.SetStartDate(pd.to_datetime(input_data[1]).year, pd.to_datetime(input_data[1]).month, pd.to_datetime(input_data[1]).day)
            self.SetEndDate(pd.to_datetime(input_data[2]).year, pd.to_datetime(input_data[2]).month, pd.to_datetime(input_data[2]).day)
            self.SetCash(100000)

            self.symbol = self.AddEquity(input_data[0], Resolution.Daily).Symbol
            self.sma_fast = SimpleMovingAverage(50)
            self.sma_slow = SimpleMovingAverage(200)
            self.RegisterIndicator(self.symbol, self.sma_fast, Resolution.Daily)
            self.RegisterIndicator(self.symbol, self.sma_slow, Resolution.Daily)

            self.lookback = 20
            self.high = self.MAX(self.symbol, self.lookback)
            self.low = self.MIN(self.symbol, self.lookback)

            self.entry_price = 0
            self.in_position = False
            self.trades_this_year = 0
            self.last_trade_year = -1
            self.trades = []

            self.SetWarmUp(200)

        def OnData(self, data):
            if self.IsWarmingUp:
                return

            current_year = self.Time.year
            if current_year != self.last_trade_year:
                self.trades_this_year = 0

            if not self.in_position and self.sma_fast.Current.Value > self.sma_slow.Current.Value and data[self.symbol].Close > self.high.Current.Value:
                # Enter long position
                quantity = self.CalculateOrderQuantity(self.symbol, 0.1)
                self.Order(self.symbol, quantity)

                self.entry_price = data[self.symbol].Close
                self.in_position = True
                self.trades_this_year += 1
                self.last_trade_year = current_year
                self.entry_time = self.Time


            elif self.in_position and (data[self.symbol].Close < self.low.Current.Value or data[self.symbol].Close < self.entry_price * 0.95):
                # Exit long position
                quantity = self.Portfolio[self.symbol].Quantity
                self.Order(self.symbol, -quantity)
                self.in_position = False
                exit_price = data[self.symbol].Close
                exit_time = self.Time
                profit = (exit_price - self.entry_price) / self.entry_price
                self.trades.append(profit)

        def OnEndOfAlgorithm(self):
            trades_per_year = len(self.trades) / (self.Time.year - self.StartDate.year) if (self.Time.year - self.StartDate.year) > 0 else len(self.trades)
            if not self.trades:
                average_profit = 0
            else:
                average_profit = np.mean(self.trades)

            returns = self.Portfolio.TotalPortfolioValueHistory.Values
            returns_list = []
            for ret in returns:
                returns_list.append(ret.Value)
            returns_series = pd.Series(returns_list)

            portfolio_returns = returns_series.pct_change().dropna()

            sharpe_ratio = np.sqrt(252) * (portfolio_returns.mean() - 0.05/252) / portfolio_returns.std() if portfolio_returns.std() > 0 else 0
            
            cumulative_returns = (1 + portfolio_returns).cumprod()
            peak = cumulative_returns.expanding(min_periods=1).max()
            drawdown = (cumulative_returns - peak) / peak
            max_drawdown = drawdown.min()

            total_return = (returns_series.iloc[-1] / returns_series.iloc[0]) - 1 if len(returns_series) > 0 else 0
            
            if total_return > 0 and self.StartDate.year != self.EndDate.year:
                years = self.EndDate.year - self.StartDate.year
                cagr = (1 + total_return)**(1/years) - 1
            else:
                cagr = 0

            self.results = {
                'CAGR': cagr,
                'SharpeRatio': sharpe_ratio,
                'MaxDrawdown': abs(max_drawdown),
                'AverageProfit': average_profit,
                'AnnualTrades': trades_per_year
            }

    # Initialize and run the backtest
    algorithm = Algorithm()
    engine = QuantConnect.Lean.Engine.Engine()
    lean_engine_bridge = QuantConnect.Lean.Engine.LeanEngineBridge()
    lean_engine_bridge.Initialize(algorithm)
    lean_engine_bridge.Run()
    return algorithm.results
