from QuantConnect import *
from QuantConnect.Algorithm import *
from QuantConnect.Data import *
from QuantConnect.Indicators import *
from QuantConnect.Parameters import *
from QuantConnect.Python import *
from QuantConnect.Securities import *
import numpy as np
import pandas as pd

def create_trading_strategy(input_params):
    """
    Creates a QuantConnect trading strategy class based on input parameters.

    Args:
        input_params: A list containing [ticker, start_date_str, end_date_str].

    Returns:
        A QCAlgorithm class definition implementing the trading strategy.
    """
    ticker = input_params[0]
    start_date_str = input_params[1]
    end_date_str = input_params[2]

    class MovingAverageCrossoverAlgorithm(QCAlgorithm):

        def Initialize(self):
            # Set historical dates from input parameters
            self.SetStartDate(start_date_str)
            self.SetEndDate(end_date_str)

            # Set initial cash
            self.SetCash(100000)

            # Add the security from input parameters and set daily resolution
            self.symbol = self.AddEquity(ticker, Resolution.Daily).Symbol

            # Define indicators: 20-day and 50-day Simple Moving Averages
            self.fast_ma_period = 20
            self.slow_ma_period = 50
            self.fast_ma = self.SMA(self.symbol, self.fast_ma_period, Resolution.Daily)
            self.slow_ma = self.SMA(self.symbol, self.slow_ma_period, Resolution.Daily)

            # Set warm-up period to the longest indicator period
            self.SetWarmUpPeriod(self.slow_ma_period)

            # Set the risk-free rate for Sharpe Ratio calculation (5%)
            self.SetRiskFreeRate(0.05)

            # Set benchmark to the traded security
            self.SetBenchmark(self.symbol)

            # Keep track of previous indicator states for crossover detection
            self.previous_fast_ma_value = 0
            self.previous_slow_ma_value = 0

            # Set a flag to ensure previous values are set after warmup
            self.indicators_initialized = False


        def OnData(self, data):
            # Wait for indicators to warm up and data to be available for the symbol
            if not self.fast_ma.IsReady or not self.slow_ma.IsReady or self.symbol not in data:
                return

            # Get current indicator values
            current_fast_ma_value = self.fast_ma.Current.Value
            current_slow_ma_value = self.slow_ma.Current.Value

            # Initialize previous values after warm-up
            if not self.indicators_initialized:
                self.previous_fast_ma_value = current_fast_ma_value
                self.previous_slow_ma_value = current_slow_ma_value
                self.indicators_initialized = True
                return # Need at least two data points after warmup for crossover check

            # Check for crossover signals
            long_signal = (self.previous_fast_ma_value <= self.previous_slow_ma_value) and (current_fast_ma_value > current_slow_ma_value)
            short_signal = (self.previous_fast_ma_value >= self.previous_slow_ma_value) and (current_fast_ma_value < current_slow_ma_value)

            # Trading Logic: Long-only SMA Crossover
            # Check if the security is available in the data slice and is tradable
            if self.symbol in data and data[self.symbol] is not None and self.Portfolio[self.symbol].IsLiquid:

                # Entry (Buy) Signal: Fast MA crosses above Slow MA
                if long_signal and not self.Portfolio[self.symbol].IsInvested:
                    # Allocate 90% of portfolio value to the symbol
                    self.SetHoldings(self.symbol, 0.9)

                # Exit (Sell) Signal: Fast MA crosses below Slow MA
                elif short_signal and self.Portfolio[self.symbol].IsInvested:
                    # Liquidate the position
                    self.Liquidate(self.symbol)

            # Update previous indicator values for the next data bar
            self.previous_fast_ma_value = current_fast_ma_value
            self.previous_slow_ma_value = current_slow_ma_value

    # Return the class definition
    return MovingAverageCrossoverAlgorithm
